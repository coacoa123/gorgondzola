<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>GARGANTUYA | Luxury Ambient Radio</title>
    <!-- Подключаем элегантные шрифты -->
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;600&family=Montserrat:wght@200;300&display=swap" rel="stylesheet">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            background: #050505;
            color: #f5f5f5;
            font-family: 'Montserrat', sans-serif;
            overflow: hidden;
            height: 100vh;
            width: 100vw;
        }

        /* --- ЭКРАН ВХОДА (нужен для разрешения автовоспроизведения звука) --- */
        #intro {
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background: #050505;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            z-index: 100;
            transition: opacity 1.5s ease, visibility 1.5s ease;
        }
        #intro.hidden { opacity: 0; visibility: hidden; pointer-events: none; }
        
        #intro h2 {
            font-family: 'Cormorant Garamond', serif;
            font-size: 2rem;
            font-weight: 300;
            letter-spacing: 8px;
            text-transform: uppercase;
            color: #D4AF37;
            margin-bottom: 40px;
            text-align: center;
            padding: 0 20px;
        }
        
        #enterBtn {
            background: transparent;
            border: 1px solid #D4AF37;
            color: #D4AF37;
            padding: 15px 45px;
            font-family: 'Montserrat', sans-serif;
            font-size: 0.8rem;
            letter-spacing: 4px;
            text-transform: uppercase;
            cursor: pointer;
            transition: all 0.4s ease;
        }
        #enterBtn:hover {
            background: #D4AF37;
            color: #050505;
            box-shadow: 0 0 30px rgba(212, 175, 55, 0.5);
        }

        /* --- АМБИЕНТНАЯ ПОДСВЕТКА (Живые пятна света) --- */
        .ambient-glow {
            position: fixed;
            width: 800px;
            height: 800px;
            border-radius: 50%;
            filter: blur(180px);
            opacity: 0.25;
            z-index: 1;
            animation: float 25s infinite ease-in-out;
            pointer-events: none;
        }
        .glow-1 {
            top: -300px; left: -300px;
            background: radial-gradient(circle, #D4AF37 0%, transparent 70%);
            animation-delay: 0s;
        }
        .glow-2 {
            bottom: -300px; right: -300px;
            background: radial-gradient(circle, #5A3A22 0%, transparent 70%);
            animation-delay: 8s;
        }
        .glow-3 {
            top: 50%; left: 50%;
            transform: translate(-50%, -50%);
            background: radial-gradient(circle, #2E0854 0%, transparent 70%);
            animation-delay: 16s;
        }

        @keyframes float {
            0%, 100% { transform: translate(0, 0) scale(1); opacity: 0.25; }
            33% { transform: translate(60px, 40px) scale(1.15); opacity: 0.35; }
            66% { transform: translate(-40px, 60px) scale(0.9); opacity: 0.2; }
        }

        /* --- ФОНОВЫЕ ИЗОБРАЖЕНИЯ (Слайдер) --- */
        .slide {
            position: absolute;
            top: 0; left: 0;
            width: 100%; height: 100%;
            background-size: cover;
            background-position: center;
            opacity: 0;
            transition: opacity 4s ease-in-out;
            z-index: 2;
            animation: slowZoom 30s infinite alternate ease-in-out;
        }
        .slide.active { opacity: 1; }
        
        /* Кинематографичная виньетка поверх картинок */
        .slide::after {
            content: '';
            position: absolute;
            top: 0; left: 0; width: 100%; height: 100%;
            background: radial-gradient(circle, transparent 20%, rgba(0,0,0,0.85) 100%);
        }

        @keyframes slowZoom {
            0% { transform: scale(1); }
            100% { transform: scale(1.15); }
        }

        /* --- ЦЕНТРАЛЬНЫЙ ТЕКСТ --- */
        #content {
            position: relative;
            z-index: 10;
            height: 100%;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
            pointer-events: none;
        }
        #content h1 {
            font-family: 'Cormorant Garamond', serif;
            font-size: clamp(3rem, 8vw, 6rem);
            font-weight: 300;
            letter-spacing: 15px;
            text-transform: uppercase;
            color: #fff;
            text-shadow: 0 4px 40px rgba(0,0,0,0.9);
            margin-bottom: 20px;
            opacity: 0;
            animation: fadeUp 2.5s forwards 1s;
        }
        #content .divider {
            width: 80px;
            height: 1px;
            background: linear-gradient(90deg, transparent, #D4AF37, transparent);
            margin-bottom: 25px;
            opacity: 0;
            animation: fadeUp 2.5s forwards 1.5s;
        }
        #content p {
            font-size: 0.9rem;
            letter-spacing: 8px;
            text-transform: uppercase;
            color: rgba(255,255,255,0.6);
            opacity: 0;
            animation: fadeUp 2.5s forwards 2s;
        }

        @keyframes fadeUp {
            from { opacity: 0; transform: translateY(30px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* --- АУДИО-КОНТРОЛЛЕР --- */
        #audioControl {
            position: fixed;
            bottom: 40px;
            right: 40px;
            z-index: 20;
            color: #D4AF37;
            font-size: 0.7rem;
            letter-spacing: 3px;
            text-transform: uppercase;
            display: flex;
            align-items: center;
            gap: 15px;
            cursor: pointer;
            opacity: 0;
            transition: opacity 1s ease 3s, background 0.3s ease, border-color 0.3s ease;
            padding: 12px 24px;
            border: 1px solid rgba(212, 175, 55, 0.2);
            border-radius: 30px;
            background: rgba(0,0,0,0.3);
            backdrop-filter: blur(8px);
        }
        #audioControl.visible { opacity: 1; }
        #audioControl:hover {
            border-color: rgba(212, 175, 55, 0.6);
            background: rgba(0,0,0,0.6);
        }
        
        .sound-wave {
            display: flex;
            gap: 3px;
            align-items: center;
            height: 15px;
        }
        .sound-wave span {
            display: block;
            width: 2px;
            background: #D4AF37;
            animation: wave 1.2s infinite ease-in-out;
        }
        .sound-wave span:nth-child(1) { height: 4px; animation-delay: 0.1s; }
        .sound-wave span:nth-child(2) { height: 10px; animation-delay: 0.2s; }
        .sound-wave span:nth-child(3) { height: 15px; animation-delay: 0.3s; }
        .sound-wave span:nth-child(4) { height: 7px; animation-delay: 0.4s; }
        
        .sound-wave.paused span { animation: none; height: 2px; }

        @keyframes wave {
            0%, 100% { transform: scaleY(0.5); }
            50% { transform: scaleY(1.3); }
        }

        .live-indicator {
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .live-dot {
            width: 6px;
            height: 6px;
            background: #ff3333;
            border-radius: 50%;
            box-shadow: 0 0 10px #ff3333;
            animation: pulse 2s infinite;
        }
        @keyframes pulse {
            0%, 100% { opacity: 1; transform: scale(1); }
            50% { opacity: 0.4; transform: scale(1.3); }
        }
    </style>
</head>
<body>

    <!-- АМБИЕНТНАЯ ПОДСВЕТКА -->
    <div class="ambient-glow glow-1"></div>
    <div class="ambient-glow glow-2"></div>
    <div class="ambient-glow glow-3"></div>

    <!-- ЭКРАН ВХОДА -->
    <div id="intro">
        <h2>Добро пожаловать в Gargantuya</h2>
        <button id="enterBtn">Войти в эфир</button>
    </div>

    <!-- ФОНОВЫЕ ИЗОБРАЖЕНИЯ -->
    <!-- Чтобы поставить свои фото, замени ссылки в url('...') на пути к своим файлам, например: url('my-photo-1.jpg') -->
    <div class="slide active" style="background-image: url('https://images.unsplash.com/photo-1470225620780-dba8ba36b745?auto=format&fit=crop&w=1920&q=80');"></div>
    <div class="slide" style="background-image: url('https://images.unsplash.com/photo-1514525253161-7a46d19cd819?auto=format&fit=crop&w=1920&q=80');"></div>
    <div class="slide" style="background-image: url('https://images.unsplash.com/photo-1493225255756-d9584f8606e9?auto=format&fit=crop&w=1920&q=80');"></div>
    <div class="slide" style="background-image: url('https://images.unsplash.com/photo-1511671782779-c97d3d27a1d4?auto=format&fit=crop&w=1920&q=80');"></div>

    <!-- ТЕКСТ ПОВЕРХ -->
    <div id="content">
        <h1>GARGANTUYA</h1>
        <div class="divider"></div>
        <p>Live Ambient Stream</p>
    </div>

    <!-- КНОПКА УПРАВЛЕНИЯ ЗВУКОМ -->
    <div id="audioControl" onclick="toggleAudio()">
        <div class="sound-wave" id="wave">
            <span></span><span></span><span></span><span></span>
        </div>
        <span>LIVE</span>
        <div class="live-indicator">
            <div class="live-dot"></div>
        </div>
    </div>

    <!-- АУДИО ПЛЕЕР -->
    <audio id="bgMusic" preload="none"></audio>

    <script>
        // ✅ ПРЯМАЯ ССЫЛКА НА ПОТОК ZENO.FM
        const radioStream = 'https://stream.zeno.fm/p49hqzfxmb4uv';
        
        const slideDuration = 10000; // 10 секунд на показ одной картинки

        const audio = document.getElementById('bgMusic');
        const intro = document.getElementById('intro');
        const enterBtn = document.getElementById('enterBtn');
        const slides = document.querySelectorAll('.slide');
        const audioControl = document.getElementById('audioControl');
        const wave = document.getElementById('wave');
        
        let currentSlide = 0;
        let isPlaying = false;

        // Запуск по клику (обходит блокировку автовоспроизведения в браузерах)
        enterBtn.addEventListener('click', () => {
            intro.classList.add('hidden');
            audioControl.classList.add('visible');
            startExperience();
        });

        function startExperience() {
            audio.src = radioStream;
            audio.play().catch(e => console.log("Ожидание взаимодействия с плеером:", e));
            isPlaying = true;
            
            // Запускаем бесконечную смену слайдов
            setInterval(nextSlide, slideDuration);
        }

        function nextSlide() {
            slides[currentSlide].classList.remove('active');
            currentSlide = (currentSlide + 1) % slides.length;
            slides[currentSlide].classList.add('active');
        }

        function toggleAudio() {
            if (isPlaying) {
                audio.pause();
                wave.classList.add('paused');
                isPlaying = false;
            } else {
                audio.play();
                wave.classList.remove('paused');
                isPlaying = true;
            }
        }

        // 🛡️ УМНАЯ ЗАЩИТА: Если интернет моргнул и поток оборвался, плеер сам переподключится через 5 секунд
        audio.addEventListener('error', function() {
            console.log("Поток прерван, автоматическое переподключение...");
            wave.classList.add('paused');
            setTimeout(() => {
                audio.load();
                if (isPlaying) {
                    audio.play().catch(e => console.log("Переподключение..."));
                    wave.classList.remove('paused');
                }
            }, 5000);
        });
    </script>
</body>
</html>
